#!/usr/bin/env bash
# luke status — the detailed version of the boot banner.
# Its first line is the banner's first line, verbatim. Verdict first,
# version last: what a user must learn in half a second is whether they
# are fine, not which version they are on.

# shellcheck source=lib.sh
source "$(dirname "$0")/lib.sh"

parse_common_flags "$@"

show_events=0
for a in "${PARSED_ARGS[@]}"; do
    case "$a" in
        --events) show_events=1 ;;
        *) die "$EXIT_USAGE" LUKE-E002 "unknown option '$a'" \
             "luke status accepts --json and --events" "luke status" ;;
    esac
done

bootc_json=$(bootc status --json 2>/dev/null || echo '{}')
booted_ver=$(jq -r '.status.booted.image.version // "unknown"' <<<"$bootc_json")
booted_dig=$(jq -r '.status.booted.image.imageDigest // ""' <<<"$bootc_json")
staged_ver=$(jq -r '.status.staged.image.version // empty' <<<"$bootc_json")
rollback_ver=$(jq -r '.status.rollback.image.version // empty' <<<"$bootc_json")
verdict=$(current_verdict)

# Power-cut-after-staging detection: a staged deployment is finalized on
# clean shutdown only. If we booted with a stale staged deployment from a
# previous boot, the update was staged but never applied — say so, or the
# user concludes the update "didn't take" and retries forever.
stale_staged=""
if [ -n "$staged_ver" ] && [ -f "$LUKE_EXPECTED" ]; then
    expected=$(cat "$LUKE_EXPECTED")
    if [ "$booted_dig" != "$expected" ] && [ ! -f "$LUKE_ROLLBACK_CAUSE" ]; then
        stale_staged="yes"
    fi
fi

if [ "$JSON" = 1 ]; then
    jq -n \
        --arg verdict "$verdict" \
        --arg booted "$booted_ver" \
        --arg staged "${staged_ver:-}" \
        --arg rollback "${rollback_ver:-}" \
        --arg stale_staged "${stale_staged:-no}" \
        --slurpfile cause <(if [ -f "$LUKE_ROLLBACK_CAUSE" ]; then cat "$LUKE_ROLLBACK_CAUSE"; else echo null; fi) \
        '{verdict: $verdict, booted: $booted,
          staged: (if $staged == "" then null else $staged end),
          rollback: (if $rollback == "" then null else $rollback end),
          staged_but_not_finalized: ($stale_staged == "yes"),
          last_rollback: $cause[0]}'
    exit "$EXIT_OK"
fi

verdict_line
echo "   Booted:   $booted_ver"
if [ -n "$staged_ver" ]; then
    echo "   Staged:   $staged_ver (applies on next reboot: luke update --reboot)"
fi
if [ -n "$rollback_ver" ]; then
    echo "   Rollback: $rollback_ver (luke undo)"
fi
if [ "$stale_staged" = "yes" ]; then
    echo "   Note: an update was staged but the machine shut down before it"
    echo "         was finalized. It will apply on the next clean reboot."
fi

if [ "$show_events" = 1 ] && [ -f "$LUKE_EVENTS" ]; then
    echo
    echo "   Recent events:"
    tail -n 10 "$LUKE_EVENTS" | jq -r '"   \(.ts)  \(.type)  \(.detail | tostring)"'
fi

echo "   Next:     luke doctor · luke update"
exit "$EXIT_OK"
