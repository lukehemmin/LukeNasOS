[Unit]
Description=LukeNasOS identity capsule (restore users, name and shares)
Documentation=file:///usr/share/doc/lukenasos/SPEC.md
# The capsule lives on @data, so nothing here can run before it is mounted.
After=var-mnt-data.mount
Requires=var-mnt-data.mount
# nftables loads the base policy; the SMB rule for restored shares is added on
# top of it, so this has to come second. Deliberately not Before=nftables: this
# unit needs a filesystem mount, nftables runs before the network exists, and
# ordering it in front of nftables risks a cycle to close a one-second window
# on a port whose share is not being served yet anyway.
After=nftables.service
# Samba reads samba.env, which this unit regenerates from the capsule.
Before=samba.service
ConditionPathExists=/var/mnt/data/.lukenasos

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/lukenasos/identity-apply

[Install]
WantedBy=multi-user.target
